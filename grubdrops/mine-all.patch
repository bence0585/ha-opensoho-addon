+
+// markExternallyClaimed logs t as collected when the inventory no longer shows
+// it, as if the user had pressed Mark as collected (fork patch). A drop the
+// account claimed elsewhere (another miner, the Twitch site) otherwise stays
+// "Skipped" and needs a manual click. A ghost drop is marked too; Mark as
+// uncollected undoes it.
+func (r *Runner) markExternallyClaimed(ctx context.Context, t plan.Target) {
+	if r.cfg.Claims == nil {
+		return
+	}
+	if err := r.cfg.Claims.RecordClaim(ctx, r.cfg.AccountID, t, ""); err != nil {
+		slog.Warn("runner mark externally claimed failed", "kind", "error",
+			"account", r.cfg.AccountID, "benefit", t.Benefit.ID, "err", err)
+		return
+	}
+	slog.Info("runner marked drop collected (gone from inventory)", "kind", "claim",
+		"account", r.cfg.AccountID, "benefit", t.Benefit.ID, "benefit_name", t.Benefit.Name)
+}
