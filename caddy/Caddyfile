# Generated: LAN-side reverse proxy for the *.gbnc.hu names that Cloudflare
# tunnels normally serve. AdGuard rewrites these names to this add-on so LAN
# clients skip the cloud round trip.
{
	auto_https disable_redirects
	storage file_system /data/caddy
}

*.gbnc.hu {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
	@md host md.gbnc.hu
	handle @md {
		reverse_proxy 192.168.1.11:5000
	}
	@lidl host lidl.gbnc.hu
	handle @lidl {
		reverse_proxy 192.168.1.11:8181
	}
	@wt host wt.gbnc.hu
	handle @wt {
		reverse_proxy 192.168.1.10:8001
	}
	@py host py.gbnc.hu
	handle @py {
		reverse_proxy 192.168.1.11:8000
	}
	@fs host fs.gbnc.hu
	handle @fs {
		reverse_proxy 192.168.1.10:8081
	}
	@dav host dav.gbnc.hu
	handle @dav {
		reverse_proxy 192.168.1.11:10080
	}
	@xampp host xampp.gbnc.hu
	handle @xampp {
		reverse_proxy 192.168.1.30:80
	}
