 }
+
+func TestBuild_MineAllQueuesOtherLinkedCampaignsLast(t *testing.T) {
+	unlinked := camp("u", "twitch", "Unlinked Game", ben("u1", 10))
+	unlinked.AccountLinked = false
+	unlinked.AccountLinkURL = "https://publisher.example/link"
+	in := Input{
+		Games: []Game{{Name: "Rust", Slug: "rust"}},
+		Campaigns: []platform.Campaign{
+			camp("other", "kick", "Other", ben("o1", 10)),
+			camp("rust", "kick", "Rust", ben("r1", 60)),
+			unlinked,
+		},
+	}
+	eq(t, ids(Build(in).Queue), []string{"r1"})
+	in.MineAll = true
+	got := Build(in).Queue
+	eq(t, ids(got), []string{"r1", "o1"})
+}
