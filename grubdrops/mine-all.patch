diff --git a/internal/plan/plan.go b/internal/plan/plan.go
index 6b8e213..db0f328 100644
--- a/internal/plan/plan.go
+++ b/internal/plan/plan.go
@@ -31,6 +31,9 @@ type Input struct {
 	NotLinked map[string]bool // benefit IDs whose claim the platform refused until linked
 	Order     []string        // session Up next override, benefit IDs
 	Priority  Priority        // campaign order; zero value is PriorityOrdered
+	// MineAll queues every other active campaign that needs no account link
+	// after all chosen games (fork patch, GRUB_MINE_ALL=1).
+	MineAll bool
 }
 
 // Priority picks how campaigns are ordered in the queue.
@@ -162,7 +165,16 @@ func Build(in Input) Result {
 	var entries []entry
 	for _, c := range in.Campaigns {
 		rank, ok := Match(in.Games, c.Game)
-		if !ok || (c.Status != "" && c.Status != "active") || c.Kind == "reward" {
+		if !ok {
+			// Fork patch: with MineAll, campaigns of games not on the list are
+			// mined after every chosen game, but only if the account is already
+			// linked, so no watch time is spent on drops that cannot be claimed.
+			if !in.MineAll || Unlinked(c) {
+				continue
+			}
+			rank = len(in.Games)
+		}
+		if (c.Status != "" && c.Status != "active") || c.Kind == "reward" {
 			continue
 		}
 		unlinked := Unlinked(c)
